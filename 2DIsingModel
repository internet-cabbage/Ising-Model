# ============================================


boxProps = dict(boxstyle='round', facecolor='white', alpha=0.5)

for slider in [betaSlider, jSlider, speedSlider]:
    slider.label.set_position((0.5,1.35))
    slider.label.set_horizontalalignment('center')
    slider.label.set_bbox(boxProps)

