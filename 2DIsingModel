#   Buttons
# ============================================

axSumMethod = fig.add_axes([0.55,0.08,0.20,0.15])
sumButton = widgets.RadioButtons(axSumMethod, ('Naive', 'Wrap-Around'))
axSize = fig.add_axes([0.75,0.08,0.2,0.15])
sizeButton = widgets.RadioButtons(axSize, (32,64,128,256,512))
sizeButton.set_active(2)

axClearData = fig.add_axes([0.1,0.03,0.15,0.05])
clearButton = widgets.Button(axClearData,'Clear Chart Data')
axResetSim = fig.add_axes([0.30,0.03,0.15,0.05])
simResetButton = widgets.Button(axResetSim,'Reset Simulation')

def buttonUpdater(val):
    global sumMethod
    sumMethod = str(sumButton.value_selected)

def clearData(val):
    global avgSpin, frameCount
    spinTot = np.sum(spins)
    avgSpin = np.array([spinTot/(N**2)])
    frameCount = np.array([0])

def resetSim(val):
    global spins, j, beta
    gridShape = (N,N)
    spins = np.random.choice([-1,1], gridShape)
    jSlider.set_val(initParams['j'])
    betaSlider.set_val(initParams['beta'])
    clearData(val)

def changeResolution(val):
    global N
    N = int(sizeButton.value_selected)
    clearData(val)
    resetSim(val)

sizeButton.on_clicked(changeResolution)
clearButton.on_clicked(clearData)
simResetButton.on_clicked(resetSim)
sumButton.on_clicked(buttonUpdater)

