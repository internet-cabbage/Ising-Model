# ============================================
#   Numba wrapper for the steps
# ============================================

@numba.njit(nogil=True)
def naiveStep(spins,stepCount,beta,j,N,h):
    for i in range(0,stepCount):
            x = np.random.randint(0,N)
            y = np.random.randint(0,N)
            spinFlip(spins,x,y, beta,j,N,h)


@numba.njit(nogil=True)
def wrapStep(spins,stepCount,beta,j,N,h):
    for i in range(0,stepCount):
            x = np.random.randint(0,N)
            y = np.random.randint(0,N)
            spinFlipWrap(spins,x,y, beta,j,N,h)


