# Slider updater

def sliderUpdate(val):
    global beta, j, stepsPerFrame
    beta = betaSlider.val
    j = jSlider.val
    stepsPerFrame = int(2**speedSlider.val)
    speedSlider.valtext.set_text(str(stepsPerFrame))

betaSlider.on_changed(sliderUpdate)
jSlider.on_changed(sliderUpdate)
speedSlider.on_changed(sliderUpdate)

# ============================================
#   Animation
# ============================================




def frameStep(stepCount,sumMethod,N):
    global avgSpin, frameCount

    # Naive Sum method

    if sumMethod == 'Naive':
        for i in range(0,stepCount):
            x = np.random.randint(0,N)
            y = np.random.randint(0,N)
            spinFlip(spins,x,y, beta,j,N)
    
    # Wrap around sum

    elif sumMethod == 'Wrap-Around':
        for i in range(0,stepCount):
            x = np.random.randint(0,N)
            y = np.random.randint(0,N)
            spinFlipWrap(spins,x,y, beta,j,N)

    spinTot = np.sum(spins)
    avgSpin = np.append(avgSpin[:], (spinTot/(N**2)))
    frameCount = np.append(frameCount[:], (frameCount[-1] + stepsPerFrame))

spinData = ax.imshow(spins, cmap='bwr', label='Data')
magData, = ax2.plot(frameCount,avgSpin)


def animate(frame):
    frameStep(stepsPerFrame, sumMethod,N)
    spinData.set_data(spins)
    magData.set_data(frameCount*1e-6,avgSpin)
    ax2.relim()
    ax2.autoscale_view()
    return [spinData,magData]



animation = FuncAnimation(fig,animate, interval=1, blit=False, save_count=60)




plt.show()