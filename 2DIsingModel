def frameStep(stepCount,sumMethod,N):
    global avgSpin, frameCount, h

    # Naive Sum method
    
    if sumMethod == 'Naive':
        naiveStep(spins,stepCount,beta,j,N,h)
    
    # Wrap around sum


    elif sumMethod == 'Wrap-Around':
        wrapStep(spins,stepCount,beta,j,N,h)

    spinTot = np.sum(spins)
    #avgSpin.append((spinTot/(N**2)))
    avgSpin = np.append(avgSpin, spinTot/(N**2))
    #frameCount.append((frameCount[-1] + stepsPerFrame))
    frameCount = np.append(frameCount, frameCount[-1] + stepsPerFrame)

