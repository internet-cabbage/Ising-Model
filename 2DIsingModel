# ============================================
# Generator Function
# ============================================

def generate(method,N):
    spins = np.zeros((N,N), dtype=np.int8)
    if method == 'Random Noise':
        spins = np.random.choice([-1,1], (N,N))
    elif method == 'Uniform':
        val = np.random.choice([-1,1])
        spins[::] = val
    elif method == 'Even Split':
        spins[:,:(N//2)], spins[:,(N//2):] = 1, -1
    return spins

spins = generate(generatorMethod,N)




@numba.njit(nogil=True)
def getEnergy(x,y,spins, spinCompare,j,N,h):
    spinCompare = - spinCompare * j
    # Boundary conditions
    #     # Central case
    if 0 < x < N-1 and 0 < y < N-1:
        sum = (spins[x+1,y] + spins[x-1,y] + spins[x, y+1] + spins[x, y-1])

    # Edge cases

    elif 0 < x < N - 1 and y==0: # Top row
        sum = (spins[x-1,0] + spins[x+1,0] + spins[x,1])
    elif 0 < x < N - 1 and y == N-1: # Bottom row
        sum = (spins[x-1, N-1] + spins[x+1, N-1] + spins[x, N-2])
    elif x == 0 and 0 < y < N-1: # Left column
        sum = (spins[0,y+1] + spins[0,y-1] + spins[1,y])
    elif x == N-1 and 0 < y < N-1: # Right column
        sum = (spins[N-1,y+1] + spins[N-1, y-1] + spins[N-2,y])
    
    # corner cases

    elif x == 0 and y == 0: # Top left
        sum = (spins[1,0] + spins[0,1])
    elif x == N-1 and y == 0: # Top right
        sum = (spins[N-2,0] + spins[N-1, 1])
    elif x == 0 and y == N-1: # Bottom left
        sum = (spins[0,N-1] + spins[1, N-1])
    elif x == N-1 and y == N-1: # Bottom right
        sum = (spins[N-2,N-1] + spins[N-1, N-2])
    return spinCompare * (sum + h)


@numba.njit(nogil=True)
def spinFlip(spins,x,y,beta,j,N,h):

    spinCurrent = spins[x,y]
    newSpin = -spinCurrent

    currentEnergy = getEnergy(x,y,spins, spinCurrent,j,N,h)
    flipEnergy = getEnergy(x,y,spins, newSpin,j,N,h)
    if flipEnergy < currentEnergy:
        spins[x,y] = newSpin
    else:
        deltaEnergy = np.abs(currentEnergy - flipEnergy)
        thermalFlipProb = np.exp(-beta * deltaEnergy)
        if thermalFlipProb > np.random.uniform():
            spins[x,y] = newSpin
        else:
            pass

# ============================================
#   Wrapped energy calculator
# ============================================

@numba.njit(nogil=True)
def getEnergyWrap(x,y,spins, spinCompare,j,N,h):
    s = - spinCompare * j
    # The pixel in question is compared against the pixels 1 (above it) 2 (to its right) 3 (below it) and 4 (to its left)
    # Vertically upwards is the direction of decreasing y
    sum = (spins[x,(y - 1) % N] +
               spins[(x+1) % N,y] +
               spins[x, (y+1) % N] +
               spins[(x-1) % N, y])
    return s * (sum + h)

@numba.njit(nogil=True)
def spinFlipWrap(spins,x,y,beta,j,N,h):
    spinCurrent = spins[x,y]
    newSpin = -spinCurrent

    currentEnergy = getEnergyWrap(x,y,spins, spinCurrent,j,N,h)
    flipEnergy = getEnergyWrap(x,y,spins, newSpin,j,N,h)
    if flipEnergy < currentEnergy:
        spins[x,y] = newSpin
    else:
        deltaEnergy = np.abs(currentEnergy - flipEnergy)
        thermalFlipProb = np.exp(-beta*deltaEnergy)
        if thermalFlipProb > np.random.uniform():
            spins[x,y] = newSpin
        else:
            pass

